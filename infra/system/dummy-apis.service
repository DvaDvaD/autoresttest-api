[Unit]
Description=AutoRest Dummy APIs (Docker Compose)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/autoresttest-api

# Start the stack
ExecStart=/usr/bin/docker compose up -d postgres market-api features-api countries-api
# Stop the stack
ExecStop=/usr/bin/docker compose stop

[Install]
WantedBy=multi-user.target
